{
    "name": "@podnos/contracts",
    "version": "0.6.0",
    "type": "module",
    "license": "MIT",
    "repository": "github:khnatovska/podnos-contracts",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "npm run build"
    },
    "peerDependencies": {
        "zod": "^4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.6",
        "typescript": "~5.9.0",
        "typescript-eslint": "^8.46.0",
        "vitest": "^5.0.0",
        "zod": "^4.5.4"
    }
}
